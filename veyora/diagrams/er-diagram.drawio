<mxfile host="app.diagrams.net" agent="veyora" version="24.0.0">
  <diagram id="veyora-er" name="ER Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="VEYORA — ER Diagram (SQLite)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="400" height="30" as="geometry" /></mxCell>
        <mxCell id="users" value="users&#10;────────────&#10;PK id&#10;name&#10;email UNIQUE&#10;password_hash&#10;role (PATIENT/DOCTOR/PROJECT_MANAGER)&#10;specialty (doctors)&#10;created_at (UTC)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#E8F1EC;strokeColor=#096C60;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="270" height="160" as="geometry" /></mxCell>
        <mxCell id="appts" value="appointments&#10;────────────&#10;PK id&#10;FK patient_id → users.id&#10;FK doctor_id → users.id&#10;date, start_time (IST)&#10;status CONFIRMED/COMPLETED/CANCELLED&#10;created_at, updated_at (UTC)&#10;UNIQUE(doctor_id,date,start_time)&#10;WHERE status='CONFIRMED'" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#096C60;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="300" height="190" as="geometry" /></mxCell>
        <mxCell id="logs" value="health_logs&#10;────────────&#10;PK id&#10;FK patient_id → users.id&#10;type HEART_RATE/TEMPERATURE/&#10;     BLOOD_PRESSURE&#10;value (bpm or °C)&#10;systolic, diastolic (mmHg)&#10;note, taken_at (UTC)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#096C60;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="270" height="180" as="geometry" /></mxCell>
        <mxCell id="reads" value="reminder_reads&#10;────────────&#10;PK user_id → users.id&#10;PK appointment_id → appointments.id&#10;read_at (UTC)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#096C60;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="risks" value="risks&#10;────────────&#10;PK id, code UNIQUE&#10;title, description, category&#10;probability 1–5, impact 1–5&#10;score = probability × impact&#10;owner, mitigation, contingency&#10;status, control_status, review_date&#10;linked_requirement/task/verification" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#096C60;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="300" height="180" as="geometry" /></mxCell>
        <mxCell id="tasks" value="tasks&#10;────────────&#10;PK id&#10;title, description&#10;status TODO/IN_PROGRESS/DONE&#10;priority, owner&#10;FK risk_id → risks.id&#10;jira_key, jira_url" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#096C60;" vertex="1" parent="1"><mxGeometry x="900" y="320" width="300" height="160" as="geometry" /></mxCell>
        <mxCell id="miles" value="milestones&#10;────────────&#10;PK id, title, due_date&#10;status, notes" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#096C60;" vertex="1" parent="1"><mxGeometry x="500" y="520" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="vers" value="verification_records&#10;────────────&#10;PK id, req_id, req_text&#10;risk_code, control&#10;test_name, expected&#10;result PENDING/PASS/FAIL&#10;kind automated/manual&#10;run_date, evidence_source" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#096C60;" vertex="1" parent="1"><mxGeometry x="900" y="540" width="300" height="160" as="geometry" /></mxCell>
        <mxCell id="r1" value="books (1..n)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="users" target="appts"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" value="attends (1..n)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="users" target="appts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="210" /></Array></mxGeometry></mxCell>
        <mxCell id="r3" value="owns (1..n)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="users" target="logs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r4" value="marks read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="appts" target="reads"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r5" value="mitigates (0..n)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="risks" target="tasks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n1" value="verification_records link to risks by risk_code (soft link); reminders are computed live — no reminder table." style="text;html=1;fontSize=11;fontColor=#66756F;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="720" width="620" height="40" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
